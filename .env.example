# 复制为 .env；密钥只保存在服务端，不要提交或发到聊天里。
# 请从服务商控制台复制与你的账号和地域对应的 OpenAI 兼容 BASE_URL。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_SEND_ENABLE_THINKING=true
LLM_TIMEOUT=60
LLM_MAX_TOKENS=700
# 微调服务：云主机使用 SSH 转发到本机时使用此地址。
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=
LOCAL_MODEL=ds-tutor-lora
# 可选：共享部署时设置入口口令，所有使用者共用；不是多用户账号系统。
APP_ACCESS_CODE=
# 公网共享时启用独立学习码，并将 APP_DB_PATH 指向持久磁盘。
APP_SHARED_MODE=false
# APP_DB_PATH=/persistent-data/study.db
